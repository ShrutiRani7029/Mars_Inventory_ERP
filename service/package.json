{
  "name": "mars-order-inventory-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Order & Inventory Sync Service for 4 sales channels + Business Central ERP",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node dist/scripts/migrate.js",
    "seed": "node dist/scripts/seed.js",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "start:mock": "node dist/mock/mock-channels.js",
    "simulate": "node dist/scripts/simulate-sale.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "setupFiles": ["<rootDir>/test/env.ts"],
    "testTimeout": 30000
  }
}
